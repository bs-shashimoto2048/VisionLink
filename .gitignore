model/**/*.pt
model/**/*.onnx
model/**/*.pdmodel
model/**/*.pdiparams
model/**/*.pdiparams.info
# PaddleOCR モデル一式（ローカル実体のみ・リポジトリには含めない）
model/paddleocr/

# Local/private inspection data
check_data/product/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

